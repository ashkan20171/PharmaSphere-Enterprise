<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="AshkanPharmacyDb" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=AshkanPharmacyDb;Integrated Security=True;Connect Timeout=5" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <startup useLegacyV2RuntimeActivationPolicy="true"><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" /></startup>
</configuration>
